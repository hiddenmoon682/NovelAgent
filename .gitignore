# Build output
build/
build-test/
build-release/
cmake-build-*/

# CTest 输出（测试日志不含源代码）
Testing/

# IDE
.vs/
.vscode/
.idea/
.qtcreator/
*.user
*.suo

# OS
.DS_Store
Thumbs.db

# MSYS2 DLLs (copied for standalone execution)
*.dll

# NovelAgent config (contains API keys)
.novelagent/
novelagent.json
config.json

# ccache 编译缓存
.ccache/

# FetchContent 依赖源码缓存（独立于 build/，删构建目录不必重新联网）
.deps-cache/

# Clangd index
.cache/

# External reference repos / example novels (not project code, user data)
_ref/
examples/

# Qoder CLI local config
.qoder/

# MCP 服务配置（个人开发环境相关）
.mcp.json

# 遗留仓库内技能目录（运行时实际读取 ~/.novelagent/skills 与 <小说项目>/skills）
skills/

# 单人开发规范（本地使用，不公开）
AGENTS.md
CLAUDE.md

# 测试、文档与验证脚本（单人开发，本地保留，不公开）
tests/
docs/
scripts/

# Python 安装管理器的运行时缓存（在仓库根目录运行 py/python 时生成，非项目内容）
Python/_cache/
