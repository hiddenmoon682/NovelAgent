{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/tauri.conf.json",
  "identifier": "novelagent-desktop",
  "description": "NovelAgent 桌面应用权限配置",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/novelagent",
          "sidecar": true
        }
      ]
    }
  ]
}
